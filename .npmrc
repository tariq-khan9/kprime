# Medusa v2 resolves modules by path string — `resolve: "./src/modules/review"`
# and `@medusajs/medusa/caching` in medusa-config.ts — and its plugin loader
# walks node_modules directly. Under pnpm's default symlinked layout those
# lookups fail at boot with "Cannot find module".
#
# A hoisted node_modules gives Medusa the flat tree it expects while keeping
# pnpm's workspace linking and single content-addressed store.
#
# If the backend ever stops booting after a dependency change, check this file
# is still being read before debugging Medusa itself.
node-linker=hoisted
