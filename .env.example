# Production environment for docker compose. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Compose reads this file automatically. It is gitignored — never commit the
# filled-in copy.
#
# Local development does NOT need this file: `docker compose up -d` starts only
# Postgres and Redis, and the two apps read their own .env / .env.local.

# ---------------------------------------------------------------- database
# CHANGE THESE. The defaults baked into docker-compose.yml are medusa/medusa,
# fine for a laptop and not for a public server.
POSTGRES_USER=kprime
POSTGRES_PASSWORD=
POSTGRES_DB=kprime

# ----------------------------------------------------------------- secrets
# Generate each separately:  openssl rand -base64 32
# medusa-config.ts refuses to start in production with the dev placeholder.
JWT_SECRET=
COOKIE_SECRET=

# -------------------------------------------------------------------- URLs
# Public HTTPS origins. No trailing slash.
#
# MEDUSA_BACKEND_URL is baked into every product image row at write time, so it
# must be correct BEFORE add-placeholder-images runs. Getting it wrong means all
# 777 image URLs point somewhere dead.
MEDUSA_BACKEND_URL=https://api.karkhanoprime.com
STOREFRONT_URL=https://karkhanoprime.com

# -------------------------------------------------------------------- CORS
# Which origins the backend accepts browser requests from.
STORE_CORS=https://karkhanoprime.com
ADMIN_CORS=https://api.karkhanoprime.com
AUTH_CORS=https://karkhanoprime.com,https://api.karkhanoprime.com

# ------------------------------------------------------------------- admin
# Used only by the one-off script that creates the first admin user.
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# ------------------------------------------------------ storefront (public)
# LEAVE BLANK ON FIRST DEPLOY. The publishable key does not exist until the
# backend has been seeded — phase 1 of DEPLOYMENT.md prints it, and you paste it
# here before building the storefront.
#
# Everything under NEXT_PUBLIC_ is compiled INTO the browser bundle. Changing
# any of them requires a rebuild (`--build`), not a restart.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Digits only, country code first, no + and no leading zero: 03xx xxxxxxx -> 92...
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_DEFAULT_REGION=pk

# ------------------------------------------------------------------- email
# Brevo SMTP relay — sends order confirmations and admin notifications.
# SMTP_PASSWORD is the SMTP key (xsmtpsib-...), a DIFFERENT credential from the
# REST API key below.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
ADMIN_NOTIFICATION_EMAIL=

# -------------------------------------------------------------- newsletter
# Brevo REST API key (xkeysib-...) — used to add contacts to a list. This is NOT
# the SMTP key above; the two are separate credentials on the same account.
BREVO_API_KEY=
BREVO_LIST_ID=

# --------------------------------------------------------------- revalidate
# Shared secret both apps use for on-demand cache invalidation. Set it.
#
# After a catalogue edit the backend POSTs to the storefront so the change is
# visible on the next request. Leave this blank and the shop still works, but
# a price or stock change can take up to an hour to appear — which on a live
# site is indistinguishable from the edit not having saved.
#
#   openssl rand -hex 24
REVALIDATE_SECRET=
