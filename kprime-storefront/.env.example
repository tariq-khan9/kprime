# Storefront environment. Copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# This is for running the storefront directly (local development). In Docker,
# these come from the root `.env` via docker-compose instead — the NEXT_PUBLIC_*
# ones as build args, the rest as runtime environment.
#
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* IS COMPILED INTO THE BROWSER BUNDLE AT BUILD TIME.
#
# Two consequences, both of which have caught people on this project already:
#   1. Changing one needs a REBUILD, not a restart. `rm -rf .next` if it seems
#      to be ignoring you.
#   2. Anything here is public. Never put a secret behind a NEXT_PUBLIC_ name.
# ---------------------------------------------------------------------------

# The ONLY backend URL the storefront reads — lib/sdk.ts uses it for both
# server-side and browser-side calls. There is deliberately no separate
# server-only variable, so this must be the public HTTPS host in production:
# it is also the <img> src of every product image.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Created by the backend's seed. Copy it from the seed output, or from
# Settings -> Publishable API Keys in Medusa admin. Without it every product
# request comes back 401 and the shop renders empty.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# This site's own origin — canonical URLs, the sitemap, and Open Graph images.
# No trailing slash. Left on localhost in production, every shared link previews
# as broken and Google indexes localhost.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

NEXT_PUBLIC_DEFAULT_REGION=pk

# Digits only, country code first, no `+` and no leading zero — wa.me silently
# produces a dead link otherwise. 0300 1234567 becomes 923001234567.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --------------------------------------------------------------- server only
# Not NEXT_PUBLIC_, so these stay out of the browser bundle.

# Brevo REST API key (xkeysib-...) for newsletter signups. This is NOT the SMTP
# key the backend sends mail with — different credential, same account.
BREVO_API_KEY=
BREVO_LIST_ID=

# Shared with the backend's REVALIDATE_SECRET. The backend POSTs to
# /api/revalidate after a catalogue edit so the change appears on the next
# request instead of after the hourly timer. Unset on either side and the
# endpoint returns 503 and edits stay slow to appear — nothing else breaks.
# Generate for production with: openssl rand -hex 24
REVALIDATE_SECRET=supersecret
