# CORS — storefront on :8000, admin on :9000 (Vite dev server uses :5173)
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Secrets — change these for anything other than local dev
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Postgres 18 (docker-compose service "postgres")
DATABASE_URL=postgres://medusa:medusa@localhost:5432/kprime

# Redis 8 (docker-compose service "redis")
# Used by the cache, event bus, and workflow engine modules.
REDIS_URL=redis://localhost:6379

# Where the storefront is reachable. Used for the order-tracking link in
# confirmation emails, and as the target of cache revalidation below.
STOREFRONT_URL=http://localhost:8000

# Must match REVALIDATE_SECRET in the storefront's .env.local. After a catalogue
# edit the backend POSTs to $STOREFRONT_URL/api/revalidate so the change is
# visible immediately rather than up to an hour later. Unset on either side and
# the call is skipped — the storefront's hourly revalidate is the fallback.
# Generate for production with: openssl rand -hex 24
REVALIDATE_SECRET=supersecret
