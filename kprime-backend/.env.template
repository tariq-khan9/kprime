# --- Order confirmation email (M2) ---------------------------------------
# Optional. Without these the backend falls back to the console notification
# provider and order emails are only logged, so a fresh clone still runs.
#
# Brevo (what KPrime uses):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<the Login from Brevo > SMTP & API > SMTP — looks like xxx@smtp-brevo.com,
#                 NOT your account email>
#   SMTP_PASSWORD=<SMTP key from the same page, starts xsmtpsib- — NOT an API key>
#
# Gmail also works: smtp.gmail.com / 587 / your address / a 16-char App Password
# (needs 2-Step Verification). Port 465 instead of 587 implies implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional From header, e.g. "Karkhano Prime <orders@yourdomain.com>".
# It must be a sender you have verified with the relay, or mail will be rejected.
SMTP_FROM=
# Reply-To. Needed when the sending domain has no MX records (a domain can send
# without being able to receive). Leave blank if replies to SMTP_FROM work.
SMTP_REPLY_TO=

# Storefront origin, used for the order-tracking link in confirmation emails.
# Omit it and the link is left out rather than pointing somewhere broken.
STOREFRONT_URL=http://localhost:8000

# Who gets new-order and cancellation emails. Comma-separated for several.
# Leave blank to disable admin notifications entirely.
ADMIN_NOTIFICATION_EMAIL=
# Backend origin, used to deep-link the admin order page from those emails.
MEDUSA_ADMIN_URL=http://localhost:9000
